{%- set active = subject or (s and s.slug) or navKey -%}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label="{{ site.name }} home">
      <span class="logo__mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      {{ site.name }}
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-btn__bars" aria-hidden="true"></span>
      Menu
    </button>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        {%- for sub in subjects %}
        <li>
          <a class="nav__link" href="/{{ sub.slug }}/" style="--subject: {{ sub.color }}"
             {% if active == sub.slug %}aria-current="page"{% endif %}>{{ sub.name }}</a>
        </li>
        {%- endfor %}
      </ul>
      <ul class="nav__list nav__list--right">
        <li><a class="nav__link" href="/shop/" {% if active == "shop" %}aria-current="page"{% endif %}>Shop</a></li>
        <li><a class="nav__link" href="/contact/" {% if active == "contact" %}aria-current="page"{% endif %}>Contact</a></li>
        <li><a class="btn nav__cta" href="/contact/#pitch">Write for us</a></li>
      </ul>
    </nav>
  </div>
</header>
