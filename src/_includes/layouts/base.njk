<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ dek or description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ dek or description or site.description }}">
  {% if image %}<meta property="og:image" content="{{ image }}">{% endif %}
  <link rel="icon" href="/images/site/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  {% if content and 'class="katex' in content %}<link rel="stylesheet" href="/css/katex/katex.min.css">{% endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/js/main.js" defer></script>
</body>
</html>
